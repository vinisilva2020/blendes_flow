# Single production environment file. Copy to .env and replace every placeholder.

DJANGO_SETTINGS_MODULE=configuration.settings.production
DJANGO_SECRET_KEY=change-me-to-a-random-value-with-at-least-50-characters
JWT_SIGNING_KEY=change-me-to-a-different-random-value-with-at-least-32-bytes

DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
DJANGO_CORS_ALLOW_CREDENTIALS=true

POSTGRES_DB=blendesflow
POSTGRES_USER=blendesflow
POSTGRES_PASSWORD=change-me-to-a-strong-database-password
POSTGRES_HOST=database
POSTGRES_PORT=5432
DATABASE_CONN_MAX_AGE=60

CACHE_URL=redis://cache:6379/1
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=blendesflow-production

JWT_ACCESS_TOKEN_LIFETIME_SECONDS=300
AUTH_SESSION_LIFETIME_SECONDS=2592000
AUTH_LOGIN_THROTTLE_RATE=5/minute
AUTH_REFRESH_THROTTLE_RATE=30/minute
USERS_REGISTRATION_THROTTLE_RATE=5/hour

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_ALLOWED_HOSTED_DOMAIN=
VITE_API_BASE_URL=/api

DJANGO_STATIC_ROOT=/var/www/static
DJANGO_MEDIA_ROOT=/var/www/media
DJANGO_SECURE_HSTS_SECONDS=31536000
