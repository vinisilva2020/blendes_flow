# Single development environment file. Copy to .env at the repository root.

DJANGO_SETTINGS_MODULE=configuration.settings.docker
DJANGO_SECRET_KEY=change-me-generated-by-project-setup
JWT_SIGNING_KEY=change-me-generated-by-project-setup

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nginx
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOW_CREDENTIALS=true

POSTGRES_DB=blendesflow
POSTGRES_USER=blendesflow
POSTGRES_PASSWORD=change-me-generated-by-project-setup
POSTGRES_HOST=database
POSTGRES_PORT=5432
DATABASE_CONN_MAX_AGE=60

JWT_ACCESS_TOKEN_LIFETIME_SECONDS=300
AUTH_SESSION_LIFETIME_SECONDS=2592000
AUTH_LOGIN_THROTTLE_RATE=5/minute
AUTH_REFRESH_THROTTLE_RATE=30/minute
USERS_REGISTRATION_THROTTLE_RATE=5/hour

# Public OAuth identifier used by both Django and Vite. Leave empty to disable.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_ALLOWED_HOSTED_DOMAIN=

# Public frontend configuration. Never place secrets in VITE_* variables.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
